# Which brain Glowbi uses: ollama | openai | anthropic | offline
LLM_PROVIDER=ollama

# --- Ollama (free, local) : `ollama pull llama3.1` ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- OpenAI or any OpenAI-compatible API (Groq, Mistral, OpenRouter, LM Studio...) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODEL=openai/gpt-oss-20b   # retried once if the main model errors or is rate limited

# Reads photos (skin, hair, labels). Uses the same key and base URL
VISION_MODEL=qwen/qwen3.8-27b

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Semantic embeddings (needs `pip install sentence-transformers`); BM25 is always on
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
USE_EMBEDDINGS=auto

# Scraper politeness
SCRAPER_USER_AGENT=GlowbiBot/0.1 (personal beauty assistant; non-commercial)
SCRAPER_DELAY_SECONDS=2.0

# Background RAG feeding (the UI never shows it)
AUTO_FEED=true
FEED_INTERVAL_HOURS=12
ADMIN_TOKEN=change-me          # protects /admin/feed, /admin/stats, /admin/search

# Speech to text: auto = browser live STT first, Whisper fallback | server = always Whisper
STT_MODE=auto
# Server STT engine: groq (uses OPENAI_API_KEY) | local (faster-whisper). Leave empty: groq if OPENAI_BASE_URL is Groq
STT_PROVIDER=
WHISPER_MODEL=base             # tiny | base | small | medium

# Glowbi's voice: kokoro (local, free) | groq (Orpheus, English only, accept its terms first) | browser
TTS_ENGINE=kokoro
TTS_VOICE_EN=af_heart          # compare voices at /static/voices.html; blends work: af_heart:60,af_sky:40
TTS_VOICE_FR=ff_siwis
TTS_GROQ_VOICE=hannah         # autumn diana hannah austin daniel troy. TTS_VOICE_EN stays the Kokoro fallback
TTS_SPEED=1.05
TTS_PITCH=1.12                 # browser playback rate: raises pitch and speed together
TTS_KOKORO_MODEL=kokoro-v1.0.onnx   # kokoro-v1.0.int8.onnx: same speed here, ~190 MB less RAM
